# 복사해서 ci/jenkins.env 로 저장하고 값을 채운다. ci/jenkins.env 는 저장소에 커밋하지 않는다.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me

# (선택) GitHub 토큰. 설정하면 Jenkins 가 인증해서 저장소를 스캔하고 PR 에 빌드 결과(상태 검사)를 남긴다.
# 필요한 권한: 저장소 Contents(읽기), Pull requests(읽기), Commit statuses(읽기·쓰기), Metadata(읽기)
# GITHUB_USER=
# GITHUB_TOKEN=
